# Ignore everything by default
*

# Except this
!/.gitignore
!/.editorconfig
!/.gitattributes
!/.oxfmtrc.json
!/.perltidyrc
!/AGENTS.md
!/README.md
!/bun.lock
!/bunfig.toml
!/compose.yaml
!/cpanfile
!/lefthook.yml
!/mise.toml
!/package.json
!/stylelint.config.mjs

!/.devcontainer/
!/.devcontainer/compose.yaml
!/.devcontainer/devcontainer.json
!/.devcontainer/Dockerfile
!/.vscode/
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json
!/.zed/
!/.zed/settings.json
!/.claude/
!/.claude/settings.json
!/.claude/hooks/
!/.claude/hooks/format.pl

!/lib/
!/lib/**
!/public/
!/icons/
!/icons/**
!/public/**
!/script/
!/script/**
!/t/
!/t/**
!/templates/
!/templates/**
!/xt/
!/xt/**

# Local settings stay ignored inside allowed dirs
**/.DS_Store
**/.env
**/.env.*
