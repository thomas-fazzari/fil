% layout 'default';
% title $entry->{title};
% content_for head => begin
  <link rel="preload" href="/fonts/redaction-10-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
% end
<article class="entry">
  <h1 class="entry__title"><a href="<%= $entry->{url} %>"><%= $entry->{title} %></a></h1>
  <div class="entry__meta">
    <span>
      <%= $entry->{feed}{title} %> · <%= $date %>
      % if ($entry->{reading_time}) {
        · <%= $entry->{reading_time} %> min read
      % }
    </span>
    <div class="entry__actions">
      % if ($entry->{comments_url}) {
        <a class="icon-button" href="<%= $entry->{comments_url} %>" title="Comments" aria-label="Comments"><%= icon 'message-square' %></a>
      % }
      <a class="icon-button" href="<%= url_for export => id => $entry->{id} %>" download data-turbo="false" title="Export to Markdown" aria-label="Export to Markdown"><%= icon 'markdown' %></a>
      <form method="post" action="<%= url_with bookmark => id => $entry->{id} %>">
        <button class="icon-button" title="<%= $entry->{starred} ? 'Remove bookmark' : 'Bookmark' %>" aria-label="Bookmark" aria-pressed="<%= $entry->{starred} ? 'true' : 'false' %>"><%= icon 'bookmark' %></button>
      </form>
    </div>
  </div>
  % if ($content) {
    <div class="entry__content">
      %== $content
    </div>
  % } else {
    <p class="empty">No text came with this entry. <a href="<%= $entry->{url} %>">Read it on the site</a>.</p>
  % }
</article>
