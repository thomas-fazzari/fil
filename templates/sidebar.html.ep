% my $list     = $current || 'unread';
% my $category = id_param('category') // '';
% my $feed     = id_param('feed')     // '';
<nav class="tree" aria-label="Categories and feeds">
  <p class="tree__label">Feeds</p>
  % for my $group (sidebar->@*) {
    % my $open = $category eq $group->{id} || grep { $feed eq $_->{id} } $group->{feeds}->@*;
    <details class="tree__group" data-category="<%= $group->{id} %>"<%= $open ? ' open' : '' %>>
      <summary class="tree__summary">
        <%= icon 'chevron-right' %>
        %= include 'tree_item', list => $list, item => $group, key => 'category', on => $category eq $group->{id}
      </summary>
      <ul class="tree__feeds">
        % for my $item ($group->{feeds}->@*) {
          <li><%= include 'tree_item', list => $list, item => $item, key => 'feed', on => $feed eq $item->{id} %></li>
        % }
      </ul>
    </details>
  % }
</nav>
